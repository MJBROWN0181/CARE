{
  "name": "care-caregiver-organizer",
  "version": "0.8.1",
  "private": true,
  "description": "Local caregiver organizer",
  "author": "CARE",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package:win": "electron-builder --win nsis --x64",
    "package:linux": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.care.organizer",
    "productName": "CARE",
    "files": [
      "desktop.html",
      "desktop.css",
      "app.js",
      "main.js",
      "preload.js",
      "assets/care-icon.png",
      "assets/care-icon.ico"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/care-icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "icon": "assets/care-icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CARE",
      "installerIcon": "assets/care-icon.ico",
      "uninstallerIcon": "assets/care-icon.ico",
      "include": "packaging/installer.nsh",
      "deleteAppDataOnUninstall": false,
      "artifactName": "CARE Setup ${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
